# ============================================================
# DEIG Portal - Environment Variables
# ============================================================

# Environment Mode
NODE_ENV=production

# Server Port (Render sets this automatically, default: 3000)
# PORT=3000

# JSON Web Token Secret (Required for production authentication)
# Generate a random 32+ character string
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_32_chars

# JWT Token Expiration (Default: 1d)
JWT_EXPIRES_IN=1d

# Database Connection URL (Optional - defaults to local SQLite if omitted)
# For persistent production storage on Render, attach a Render PostgreSQL
# database and paste its Internal Database URL here:
# DATABASE_URL=postgresql://user:password@host:5432/deig_db
DATABASE_URL=

# Public Application URL (Optional, e.g. https://your-service.onrender.com)
APP_URL=

# Media Storage Provider (Default: local)
STORAGE_TYPE=local
